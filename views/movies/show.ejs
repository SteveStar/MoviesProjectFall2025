<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/united/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/movies">All Movies</a></li>
                <li class="breadcrumb-item active"><%= movie.name %></li>
            </ol>
        </nav>

        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h1 class="h3 mb-0"><%= movie.name %></h1>
                    <div class="btn-group">
                        <a href="/movies/<%= movie._id %>/edit" class="btn btn-light btn-sm">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <form method="POST" action="/movies/<%= movie._id %>?_method=DELETE" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm ms-1" 
                                    onclick="return confirm('Are you sure you want to delete this movie?')">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h4 class="text-muted mb-3">Description</h4>
                        <p class="lead"><%= movie.description %></p>
                        
                        <div class="mt-4">
                            <h4 class="text-muted mb-3">Genres</h4>
                            <div>
                                <% movie.genres.forEach(genre => { %>
                                    <span class="badge bg-secondary me-1 mb-1 fs-6"><%= genre %></span>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Movie Details</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-5">Release Year:</dt>
                                    <dd class="col-sm-7"><%= movie.year %></dd>
                                    
                                    <dt class="col-sm-5">Duration:</dt>
                                    <dd class="col-sm-7">
                                        <%= Math.floor(movie.duration / 60) %>h <%= movie.duration % 60 %>m
                                        <small class="text-muted">(<%= movie.duration %> minutes)</small>
                                    </dd>
                                    
                                    <dt class="col-sm-5">Rating:</dt>
                                    <dd class="col-sm-7">
                                        <% if (movie.rating) { %>
                                            <span class="badge bg-warning text-dark fs-6"><%= movie.rating %>/10</span>
                                        <% } else { %>
                                            <span class="text-muted">Not rated</span>
                                        <% } %>
                                    </dd>
                                    
                                    <dt class="col-sm-5">Added:</dt>
                                    <dd class="col-sm-7">
                                        <small class="text-muted">
                                            <%= movie.createdAt.toLocaleDateString() %>
                                        </small>
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-3">
            <a href="/movies" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to All Movies
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>