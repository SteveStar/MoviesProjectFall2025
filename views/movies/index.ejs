<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Bootstrap Theme -->
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/united/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <%- include('../partials/navbar') %>


    <div class="container mt-4">

        <h1 class="text-center mb-4"><%= title %></h1>

        <!-- Add Movie Button -->
        <% if (currentUser) { %>
            <div class="text-center mb-3">
                <a href="/movies/new" class="btn btn-primary">Add a New Movie</a>
            </div>
        <% } else { %>
            <div class="alert alert-warning text-center">
                You must be logged in to add movies.
            </div>
        <% } %>

        <!-- Movie List -->
        <% if (movies.length > 0) { %>
            <div class="row">
                <% movies.forEach(movie => { %>

                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">

                            <div class="card-body">
                                <h5 class="card-title"><%= movie.name %></h5>
                                <h6 class="card-subtitle mb-2 text-muted"><%= movie.year %></h6>

                                <p class="card-text">
                                    <%= movie.description.substring(0, 100) %>...
                                </p>

                                <!-- Genres -->
                                <div class="mb-2">
                                    <% movie.genres.forEach(genre => { %>
                                        <span class="badge bg-secondary me-1"><%= genre %></span>
                                    <% }) %>
                                </div>

                                <!-- Rating & Duration -->
                                <p class="card-text">
                                    <small class="text-muted">
                                        Rating: <%= movie.rating %>/10 |
                                        Duration: <%= Math.floor(movie.duration / 60) %>h <%= movie.duration % 60 %>m
                                    </small>
                                </p>
                            </div>

                            <!-- Card Footer Buttons -->
                            <div class="card-footer bg-light d-flex justify-content-between">

                                <!-- View button always enabled -->
                                <a href="/movies/<%= movie._id %>" class="btn btn-sm btn-outline-primary">View</a>

                                <% if (currentUser && movie.user && movie.user.toString() === currentUser._id.toString()) { %>

                                    <!-- Owner: Buttons enabled -->
                                    <a href="/movies/<%= movie._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>

                                    <form method="POST" action="/movies/<%= movie._id %>?_method=DELETE" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this movie?')">
                                            Delete
                                        </button>
                                    </form>

                                <% } else { %>

                                    <!-- Non-owner or logged-out: Disabled -->
                                    <button class="btn btn-sm btn-outline-secondary" disabled>Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" disabled>Delete</button>

                                <% } %>

                            </div>
                        </div>
                    </div>

                <% }) %>
            </div>

        <% } else { %>

            <div class="alert alert-info text-center">
                No movies were found. 
                <% if (currentUser) { %>
                    <a href="/movies/new">Add a movie.</a>
                <% } %>
            </div>

        <% } %>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
