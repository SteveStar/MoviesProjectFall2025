<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/united/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <%- include('../partials/navbar') %>


    <div class="container mt-4" style="max-width: 900px;">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/movies">All Movies</a></li>
                <li class="breadcrumb-item"><a href="/movies/<%= movie._id %>"><%= movie.name %></a></li>
                <li class="breadcrumb-item active">Edit</li>
            </ol>
        </nav>

        <!-- Edit Movie Card -->
        <div class="card shadow-sm">
            <div class="card-header text-center">
                <h2 class="mb-0">Edit Movie</h2>
            </div>

            <div class="card-body">

                <!-- Error -->
                <% if (typeof error !== 'undefined') { %>
                    <div class="alert alert-danger text-center">
                        <%= error %>
                    </div>
                <% } %>

                <form method="POST" action="/movies/<%= movie._id %>?_method=PUT">

                    <!-- Name -->
                    <div class="mb-3">
                        <label class="form-label">Movie Name *</label>
                        <input 
                            type="text"
                            class="form-control"
                            name="name"
                            value="<%= movie.name || '' %>"
                            required
                        >
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <textarea
                            class="form-control"
                            name="description"
                            rows="4"
                            required
                        ><%= movie.description || '' %></textarea>
                    </div>

                    <!-- Year + Duration -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Release Year *</label>
                            <input 
                                type="number"
                                class="form-control"
                                name="year"
                                min="1888"
                                max="<%= new Date().getFullYear() + 5 %>"
                                value="<%= movie.year || '' %>"
                                required
                            >
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Duration (minutes) *</label>
                            <input 
                                type="number"
                                class="form-control"
                                name="duration"
                                min="1"
                                value="<%= movie.duration || '' %>"
                                required
                            >
                        </div>
                    </div>

                    <!-- Rating -->
                    <div class="mb-3">
                        <label class="form-label">Rating (0–10)</label>
                        <input
                            type="number"
                            class="form-control"
                            name="rating"
                            step="0.1"
                            min="0"
                            max="10"
                            value="<%= movie.rating || '' %>"
                        >
                    </div>

                    <!-- Genres -->
                    <div class="mb-4">
                        <label class="form-label">Genres</label>

                        <div class="border rounded p-3">
                            <div class="row">
                                <% const genres = [
                                    'Action', 'Adventure', 'Comedy', 'Drama', 'Fantasy', 'Horror',
                                    'Romance', 'Sci-Fi', 'Thriller', 'Mystery', 'Crime', 'Animation',
                                    'Documentary', 'Family', 'Musical'
                                ]; %>

                                <% genres.forEach(genre => { %>
                                    <div class="col-md-4 col-sm-6 mb-2">
                                        <div class="form-check">
                                            <input 
                                                class="form-check-input"
                                                type="checkbox"
                                                name="genres"
                                                value="<%= genre %>"
                                                id="genre-<%= genre %>"
                                                <%= (movie.genres && movie.genres.includes(genre)) ? "checked" : "" %>
                                            >
                                            <label class="form-check-label" for="genre-<%= genre %>">
                                                <%= genre %>
                                            </label>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between flex-wrap gap-2 mt-4">
                        <a href="/movies/<%= movie._id %>" class="btn btn-outline-secondary">Cancel</a>
                        <a href="/movies" class="btn btn-outline-secondary">Back to Movies</a>
                        <button type="submit" class="btn btn-primary">Update Movie</button>
                    </div>

                </form>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
