<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/united/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <%- include('../partials/navbar') %>


    <div class="container mt-4" style="max-width: 750px;">

        <h1 class="text-center mb-4"><%= title %></h1>

        <!-- Error Alert -->
        <% if (typeof error !== 'undefined') { %>
            <div class="alert alert-danger text-center">
                <%= error %>
            </div>
        <% } %>

        <!-- Card Wrapper -->
        <div class="card shadow-sm">
            <div class="card-body">

                <form method="POST" action="/movies">

                    <!-- Movie Name -->
                    <div class="mb-3">
                        <label class="form-label">Movie Name</label>
                        <input 
                            type="text" 
                            class="form-control" 
                            name="name" 
                            value="<%= movie.name || '' %>" 
                            placeholder="Enter movie name"
                            required
                        >
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea 
                            class="form-control" 
                            name="description" 
                            rows="3"
                            placeholder="Short description of the movie"
                            required
                        ><%= movie.description || '' %></textarea>
                    </div>

                    <!-- Year + Rating -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Year of Release</label>
                                <input 
                                    type="number" 
                                    class="form-control" 
                                    name="year" 
                                    value="<%= movie.year || '' %>" 
                                    required
                                >
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Rating (0-10)</label>
                                <input 
                                    type="number" 
                                    class="form-control" 
                                    name="rating" 
                                    step="0.1"
                                    min="0"
                                    max="10"
                                    value="<%= movie.rating || '' %>"
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Duration -->
                    <div class="mb-3">
                        <label class="form-label">Duration (minutes)</label>
                        <input 
                            type="number" 
                            class="form-control" 
                            name="duration" 
                            value="<%= movie.duration || '' %>" 
                            placeholder="E.g. 120"
                            required
                        >
                    </div>

                    <!-- Genres -->
                    <div class="mb-3">
                        <label class="form-label">Genres</label>

                        <div class="border rounded p-3">

                            <% const genres = [
                                'Action', 'Adventure', 'Comedy', 'Drama', 'Fantasy',
                                'Horror', 'Romance', 'Sci-Fi', 'Thriller', 'Mystery',
                                'Crime', 'Animation', 'Documentary', 'Family', 'Musical'
                            ]; %>

                            <% genres.forEach(genre => { %>
                                <div class="form-check form-check-inline">
                                    <input 
                                        class="form-check-input" 
                                        type="checkbox" 
                                        name="genres" 
                                        value="<%= genre %>"
                                        id="genre-<%= genre %>"
                                        <%= (movie.genres && movie.genres.includes(genre)) ? 'checked' : '' %>
                                    >
                                    <label class="form-check-label" for="genre-<%= genre %>">
                                        <%= genre %>
                                    </label>
                                </div>
                            <% }) %>

                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        <a href="/movies" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Add Movie</button>
                    </div>

                </form>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
