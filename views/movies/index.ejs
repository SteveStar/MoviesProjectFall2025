<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!--wont add this to each ejs file, i used bootstrap for the styles. if you do want to use built-in styles. please let us know in the blackboard/whatsapp/teams chat-->
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/united/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1 class="mb-4"><%= title %></h1>
        
        <a href="/movies/new" class="btn btn-primary mb-3">Add a new movie</a>
        
        <% if (movies.length > 0) { %>
            <div class="row">
                <% movies.forEach(movie => { %>
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title"><%= movie.name %></h5>
                                <h6 class="card-subtitle mb-2 text-muted"><%= movie.year %></h6>
                                <p class="card-text"><%= movie.description.substring(0, 100) %>...</p>
                                <div class="mb-2">
                                    <% movie.genres.forEach(genre => { %>
                                        <span class="badge bg-secondary me-1"><%= genre %></span>
                                    <% }) %>
                                </div>
                                <p class="card-text">
                                    <small class="text-muted">
                                        Rating: <%= movie.rating %>/10 | 
                                        Duration: <%= Math.floor(movie.duration / 60) %>h <%= movie.duration % 60 %>m
                                    </small>
                                </p>
                            </div>
                            <div class="card-footer">
                                <a href="/movies/<%= movie._id %>" class="btn btn-sm btn-outline-primary">View</a>
                                <a href="/movies/<%= movie._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="POST" action="/movies/<%= movie._id %>?_method=DELETE" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                        onclick="return confirm('Are you sure you want to delete this movie?')">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="alert alert-info">
                No movies were found. <a href="/movies/new">Add a movie.</a>
            </div>
        <% } %>
    </div>
</body>
</html>