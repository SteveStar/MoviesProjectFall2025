<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4 custom-navbar">
    <div class="container">
        <a class="navbar-brand nav-title" href="/">MovieDB</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav me-auto nav-links">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/movies">Movies</a>
                </li>

                <% if (currentUser) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/movies/new">Add Movie</a>
                    </li>
                <% } %>
            </ul>

            <!-- RIGHT SIDE -->
            <ul class="navbar-nav ms-auto nav-links align-items-center">

                <% if (!currentUser) { %>

                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/register">Register</a>
                    </li>

                <% } else { %>

                    <li class="nav-item">
                        <span class="navbar-text user-label">
                            Logged in as <strong><%= currentUser.username %></strong>
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link logout-link" href="/logout">Logout</a>
                    </li>

                <% } %>

            </ul>

        </div>
    </div>
</nav>


<style>
    /* Navbar title */
    .nav-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #ffffff !important;
    }

      .nav-links .nav-link {
        font-size: 1.15rem;
        font-weight: 600;
        margin-right: 12px;      
        transition: all 0.25s ease;
        color: #ffffff !important;
    }

    
    .nav-links .nav-link:hover {
        background-color: #ffcc33;   
        color: #1a1a1a !important;   
        border-radius: 6px;
        transform: scale(1.10);      
    }


    .user-label {
        font-size: 1.15rem;
        color: #ffe49f;              
        font-weight: 700;
        margin-right: 20px;          
        display: flex;
        align-items: center;
    }

    
    .logout-link {
        font-size: 1.15rem;
        font-weight: 600;
        padding: 10px 18px;
        margin-left: 12px;
        transition: all 0.25s ease;
        color: #ffffff !important;
    }

    .logout-link:hover {
        background-color: #ffcc33;
        color: #1a1a1a !important;
        border-radius: 6px;
        transform: scale(1.10);
    }

 
    .navbar-nav {
        align-items: center;
    }
</style>
