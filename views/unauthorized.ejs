<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/united/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <%- include('partials/navbar') %>


    <div class="container mt-5" style="max-width: 600px;">

        <h1 class="text-center text-warning mb-4"><%= title %></h1>

        <div class="alert alert-warning text-center">
            You do not have permission to view this page.
        </div>

        <!-- If user is NOT logged in -->
        <% if (!currentUser) { %>
            <p class="text-center">Please log in to continue.</p>

            <div class="d-flex justify-content-center gap-3 mt-3">
                <a href="/login" class="btn btn-primary">Login</a>
                <a href="/register" class="btn btn-success">Register</a>
            </div>
        <% } else { %>
            <p class="text-center">Your account does not have access to this content.</p>
        <% } %>

        <div class="text-center mt-4">
            <a href="/movies" class="btn btn-outline-secondary">Back to Movies</a>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
